# Inkling-2-Mini on single NVIDIA DGX Spark (vLLM + Humming MoE + DSpark)
MODEL_ID=thinkingmachines/Inkling-2-Mini
HOST=0.0.0.0
PORT=8000
API_KEY=
HF_CACHE_DIR=${HOME}/.cache/huggingface
VLLM_CACHE_DIR=${HOME}/.cache/vllm
HF_TOKEN=

VLLM_IMAGE=vllm/vllm-openai:inkling-2-mini
VLLM_MOE_BACKEND=humming
VLLM_MAX_MODEL_LEN=262144
VLLM_MAX_NUM_SEQS=8
VLLM_GPU_MEM_UTIL=0.65
VLLM_NUM_SPEC_TOKENS=7
